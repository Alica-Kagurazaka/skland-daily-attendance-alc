{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-05-17",
  "name": "skland-daily-attendance-alc",
  "compatibility_flags": ["nodejs_als"],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "KV","id": "c6793ada4a5c4db2a381fef938706f6f"
    }
  ],
  "triggers": {
    "crons": ["30 */2 * * *"]
  }
}
